{
  "name": "democena-studio",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "capture": "node scripts/capture.mjs",
    "dev": "remotion studio src/index.tsx --props=project.json --no-open",
    "render": "node scripts/render.mjs",
    "playbook": "node scripts/prepare-playbook.mjs && vite --config vite.playbook.config.ts",
    "playbook:build": "vite build --config vite.playbook.config.ts",
    "typecheck": "tsc --noEmit",
    "preview": "node scripts/render.mjs --still"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.525",
    "@remotion/cli": "4.0.525",
    "@remotion/player": "4.0.525",
    "@remotion/renderer": "4.0.525",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.525",
    "vite": "7.3.6"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.3"
  }
}
