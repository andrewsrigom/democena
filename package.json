{
  "name": "democena",
  "version": "0.1.0-alpha.1",
  "description": "Scripted product demos with expressive typography, real browser capture, and optional Remotion rendering.",
  "keywords": [
    "demo",
    "demo-video",
    "video",
    "screencast",
    "playwright",
    "ffmpeg",
    "documentation",
    "gif",
    "subtitles",
    "transcript",
    "cli",
    "typescript",
    "ai",
    "agent",
    "ai-agents"
  ],
  "license": "Apache-2.0",
  "author": "andrewsrigom",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewsrigom/democena.git"
  },
  "homepage": "https://github.com/andrewsrigom/democena#readme",
  "bugs": "https://github.com/andrewsrigom/democena/issues",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "democena": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates",
    "scripts/postinstall.mjs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "UPSTREAM.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "cd examples/basic && node ../../dist/cli/index.js record",
    "visual-030": "bash scripts/visual-030.sh",
    "postinstall": "node scripts/postinstall.mjs",
    "smoke:docker": "bash scripts/docker-smoke.sh",
    "prepublishOnly": "npm run build",
    "test:browser": "node scripts/check-overlay.mjs",
    "studio:install": "npm --prefix studio ci --ignore-scripts",
    "studio:dev": "npm --prefix studio run dev",
    "studio:capture": "npm --prefix studio run capture",
    "studio:render": "npm --prefix studio run render",
    "studio:preview": "npm --prefix studio run preview",
    "playbook": "npm --prefix studio run playbook",
    "benchmark:visual": "node scripts/benchmark-visual.mjs",
    "mcp:install": "npm --prefix mcp ci --ignore-scripts",
    "mcp:build": "npm --prefix mcp run build",
    "mcp:test": "npm --prefix mcp test",
    "test:capture": "node --test --test-concurrency=1 capture/test/*.test.mjs"
  },
  "dependencies": {
    "@playwright/test": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@playwright/test@1.62.1": true
  },
  "contributors": [
    {
      "name": "Ben van den Berge",
      "url": "https://github.com/pesuto-dev",
      "note": "Original Demotale author"
    }
  ],
  "x-democena-modified": "Independent fork of Demotale 0.3.0; see UPSTREAM.md and NOTICE."
}
